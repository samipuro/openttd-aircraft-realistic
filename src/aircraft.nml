// Junkers Ju 52.
switch (FEAT_AIRCRAFT, SELF, sw_capacity_101, cargo_type_in_veh) {
    MAIL: return 10;
    GOOD: return 10;
    VALU: return 5;
    GOLD: return 5;
    DIAM: return 5;
    return 15;
}
switch (FEAT_AIRCRAFT, SELF, sw_mail_101, cargo_type_in_veh) {
    PASS: return 5;
    return 0;
}
item (FEAT_AIRCRAFT, aircraft_101, 101) {
    property {
        name: string(STR_NAME_101);
        climates_available: ALL_CLIMATES;
        introduction_date: date(1930, 9, 11);
        model_life: 28;
        retire_early: 0;
        vehicle_life: 20;
        reliability_decay: 20;
        refittable_cargo_classes: 0;
        non_refittable_cargo_classes: 0;
        cargo_allow_refit: [PASS, MAIL, GOOD, VALU, GOLD, DIAM];
        loading_speed: 20;
        cost_factor: 8;
        running_cost_factor: 41;
        sprite_id: SPRITE_ID_NEW_AIRCRAFT;
        speed: 136 mph;
        range: 0;
        aircraft_type: AIRCRAFT_TYPE_SMALL;
        acceleration: 20;
        sound_effect: SOUND_TAKEOFF_PROPELLER;
        passenger_capacity: 15;
        mail_capacity: 5;
    }
    graphics {
        passenger_capacity: sw_capacity_101;
        mail_capacity: sw_mail_101;
        purchase_passenger_capacity: 15;
        purchase_mail_capacity: 5;
        purchase: ss_aircraft_101;
        default: sw_graphics_101;
    }
}

