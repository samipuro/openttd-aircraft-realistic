// Generated from data/aircraft.csv. Do not edit by hand.
grf {
    grfid: "ARR\01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    url: string(STR_GRF_URL);
    version: 1;
    min_compatible_version: 1;
}

cargotable { PASS, MAIL, GOOD, VALU, GOLD, DIAM }

// Share the engine ID scope with Original vehicle names when it is used, so both sets address the same default aircraft in any load order.
if (grf_future_status("\66\72\4F\4E")) {
    engine_override("\66\72\4F\4E");
}

// Remove all default aircraft from every climate.
disable_item(FEAT_AIRCRAFT);

switch (FEAT_AIRCRAFT, SELF, sw_callback_failed, 0) {
    return CB_FAILED;
}

